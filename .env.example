ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=50
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_LLM_CALLS=8
MAX_CONCURRENT_EXTRACTIONS=2
LLM_TIMEOUT_SECONDS=60
MAX_EXTRACTION_DURATION_SECONDS=300
MAX_ANALYSIS_INPUT_CHARS=60000

# Analysis provider: auto (Nebius when key exists, otherwise disabled), nebius, or offline.
# offline is deterministic simulated output for demos; it does not call an AI model.
ANALYSIS_PROVIDER=nebius
# Optional Tavily Usage
TAVILY_API_KEY=<Your_Tavily_API_Key_here>
# Optional unless ANALYSIS_PROVIDER=nebius.
NEBIUS_API_KEY=<Your_Nebius_API_Key_here>
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_CLAIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
MAX_PENDING_EXTRACTION_JOBS=20
DATA_DIR=data
FRONTEND_ORIGIN=http://localhost:5173

JOB_RETENTION_DAYS=30
JOB_CLEANUP_INTERVAL_SECONDS=3600
ORPHAN_ARTIFACT_GRACE_SECONDS=3600
